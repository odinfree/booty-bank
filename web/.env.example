# Optional for local UI development. Production defaults to the canonical endpoint.
NEXT_PUBLIC_WAITLIST_API_URL=http://localhost:8787/api/waitlist
NEXT_PUBLIC_WALLET_API_URL=http://localhost:8787

# Public client configuration. Keep the Privy app secret in Worker secrets only.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_STARKNET_NETWORK=mainnet
# Optional dedicated RPC. Without this, Starkzap's network preset is used.
NEXT_PUBLIC_STARKNET_RPC_URL=
